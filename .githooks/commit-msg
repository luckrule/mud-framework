#!/bin/sh
msg_file="$1"
first_line=$(head -n 1 "$msg_file")

case "$first_line" in
  "Merge "* | "Revert "* | "fixup! "* | "squash! "* | "amend! "*) exit 0 ;;
esac

subject=${first_line#*: }

if ! printf '%s' "$first_line" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\(.+\))?!?: .{2,72}$' ||
   ! printf '%s' "$subject" | grep -Eq '^[^[:space:]](.*[^[:space:]])?$'; then
  printf '%s\n' "提交信息不符合规范：$first_line" >&2
  printf '%s\n' "格式：<type>(<scope>): <主题>" >&2
  printf '%s\n' "type：feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert" >&2
  exit 1
fi
