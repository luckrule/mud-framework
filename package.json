{
  "name": "mud-framework",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test --parallel",
    "test:unit": "bun test packages --parallel",
    "test:integration": "bun test tests/integration --parallel",
    "smoke:package": "bun run scripts/package-smoke.ts",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "bun-types": "1.4.5",
    "mud-framework-connector-ws": "workspace:*",
    "mud-framework-core": "workspace:*",
    "mud-framework-storage-sqlite": "workspace:*",
    "mud-framework-test-support": "workspace:*",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2008",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.5"
  }
}
